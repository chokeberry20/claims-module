{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClaimsDb": ""
  },
  "Tenancy": {
    "OrganisationId": "3f2b8c1e-6d4a-4e9b-a7c2-5d1e0f9b8a64"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "Provider": "AzureBlob"
  },
  "GlPosting": {
    "SimulatedFailureRate": 0,
    "StalePendingAfter": "00:10:00"
  },
  "Hangfire": {
    "ServerEnabled": true,
    "RetryAttempts": 3,
    "RetryDelaysSeconds": [ 10, 30, 60 ],
    "Dashboard": {
      "Username": "admin"
    }
  },
  "Jwt": {
    "Issuer": "claims-module",
    "Audience": "claims-module-api",
    "Lifetime": "08:00:00"
  },
  "DemoUsers": {
    "Users": [
      { "Id": "a1000000-0000-0000-0000-000000000001", "UserName": "handler1", "DisplayName": "Hannah Handler", "Role": "Handler" },
      { "Id": "a1000000-0000-0000-0000-000000000002", "UserName": "handler2", "DisplayName": "Harry Handler", "Role": "Handler" },
      { "Id": "a2000000-0000-0000-0000-000000000001", "UserName": "supervisor1", "DisplayName": "Sam Supervisor", "Role": "Supervisor" },
      { "Id": "a3000000-0000-0000-0000-000000000001", "UserName": "manager1", "DisplayName": "Mia Manager", "Role": "Manager" }
    ]
  }
}
