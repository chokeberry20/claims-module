<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- API: composition root. Controllers, middleware, configuration, startup. -->
  <PropertyGroup>
    <RootNamespace>ClaimsModule.API</RootNamespace>
    <UserSecretsId>claimsmodule-api-7c1d2b8e</UserSecretsId>
    <!-- XML comments feed the Swagger descriptions; not every public member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaimsModule.Application\ClaimsModule.Application.csproj" />
    <ProjectReference Include="..\ClaimsModule.Persistence\ClaimsModule.Persistence.csproj" />
    <ProjectReference Include="..\ClaimsModule.Infrastructure\ClaimsModule.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClaimsModule.IntegrationTests" />
  </ItemGroup>
</Project>
