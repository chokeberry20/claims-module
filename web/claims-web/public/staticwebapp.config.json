{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css,json,ico,png,svg,woff2}"]
  },
  "routes": [
    {
      "route": "/app-config.json",
      "headers": { "cache-control": "no-store" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
